{
  "name": "ormancik",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "PATH=\"$HOME/.local/bin:$PATH\" expo start --web --port 43123",
    "tts:sample": "PATH=\"$HOME/.local/bin:$PATH\" node scripts/tts-synthesize.mjs",
    "typecheck": "tsc --noEmit",
    "eas:login": "npx eas-cli@latest login",
    "eas:init": "npx eas-cli@latest init",
    "eas:configure": "npx eas-cli@latest build:configure",
    "eas:build:preview": "npx eas-cli@latest build --profile preview",
    "eas:build:android": "npx eas-cli@latest build --platform android --profile production",
    "eas:build:android:preview": "npx eas-cli@latest build --platform android --profile preview",
    "eas:build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "eas:build:all": "npx eas-cli@latest build --platform all --profile production",
    "eas:submit:android": "npx eas-cli@latest submit --platform android --profile production",
    "eas:submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "play:build": "npm run eas:build:android",
    "play:submit": "npm run eas:submit:android",
    "store:screenshots": "node scripts/capture-store-screenshots.mjs",
    "store:listing-phones": "node scripts/capture-listing-phones.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "~58.0.19",
    "expo-av": "^16.0.8",
    "expo-blur": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.20",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
